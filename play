#!/usr/bin/env bash
# One-shot install + launch for Omarchy / Arch.
set -euo pipefail
cd "$(dirname "$0")"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Need python3. On Omarchy: sudo pacman -S python" >&2
  exit 1
fi

if [[ ! -d .venv ]]; then
  python3 -m venv .venv
fi
# shellcheck disable=SC1091
source .venv/bin/activate

python - <<'PY' || pip install -r requirements.txt
import importlib.util
import sys
sys.exit(0 if importlib.util.find_spec("pygame") else 1)
PY

exec python -m omunch "$@"
