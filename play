#!/usr/bin/env bash
# Install deps if needed, then launch Omunch.
set -euo pipefail
cd "$(dirname "$0")"

echo "Omunch — starting…"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Missing python3. On Omarchy run: sudo pacman -S python" >&2
  exit 1
fi

# Prefer system pygame (fast on Arch/Omarchy) when present.
if python3 -c 'import pygame' 2>/dev/null; then
  echo "Using system pygame."
  exec python3 -m omunch "$@"
fi

echo "No system pygame — using a local venv (first run may take a minute)…"
if [[ ! -d .venv ]]; then
  echo "Creating .venv…"
  python3 -m venv .venv
fi
# shellcheck disable=SC1091
source .venv/bin/activate

if ! python -c 'import pygame' 2>/dev/null; then
  echo "Installing pygame…"
  pip install --upgrade pip
  pip install -r requirements.txt
fi

echo "Launching…"
exec python -m omunch "$@"
